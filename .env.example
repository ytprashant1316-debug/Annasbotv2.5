# Copy this file to .env and fill in your own values.
# Do NOT share your filled-in .env — it contains secrets.

# [REQUIRED] Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# [REQUIRED] MongoDB connection string (Atlas or self-hosted)
MONGO_URI=

# [REQUIRED] Your Telegram user ID (becomes the bot owner).
# Get it from @userinfobot. Multiple owners: use OWNER_IDS=111,222
OWNER_ID=

# [OPTIONAL] MTProto credentials from https://my.telegram.org
# Only needed for the /index command (backfills chat history).
TG_API_ID=
TG_API_HASH=
